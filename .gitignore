# Byte-compiled / optimized / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
.streamlit/secrets.toml

# Cached Fed statements (regenerated at runtime)
data/statements/*
!data/statements/.gitkeep

# Generated outputs
outputs/*.csv
outputs/figures/*
!outputs/figures/.gitkeep

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
